---
// src/pages/steam.astro
import PageLayout from '../layouts/PageLayout.astro';

const frontmatter = {
  title: '我的 Steam 游戏库',
  coverTitle: '🎮 我的 Steam 游戏库',
  description: '通过 Steam Web API 自动同步的游戏列表',
  comments: false,
};

const STEAM_API_KEY = process.env.STEAM_API_KEY;
const STEAM_ID = '76561199521447257';

let allGames = [];
let error = null;

if (!STEAM_API_KEY) {
  error = '未配置 Steam API Key';
} else {
  try {
    // 获取游戏列表
    const url = `https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key=${STEAM_API_KEY}&steamid=${STEAM_ID}&include_appinfo=true&include_played_free_games=true&format=json`;
    const res = await fetch(url);
    const json = await res.json();
    allGames = json.response.games || [];
    // 按游玩时长降序
    allGames.sort((a, b) => b.playtime_forever - a.playtime_forever);

    // ---- 获取每个游戏的详情（封面、价格、评分） ----
    // 这里保留之前获取详情的逻辑
    // 为了速度，可以只对前 100 个游戏获取详情，或者全部获取
    const topGames = allGames.slice(0, 200); // 最多获取200个游戏的详情
    const enriched = await Promise.all(
      topGames.map(async (game) => {
        try {
          const detailUrl = `https://store.steampowered.com/api/appdetails?appids=${game.appid}`;
          const detailRes = await fetch(detailUrl);
          const detailJson = await detailRes.json();
          const detail = detailJson[game.appid]?.data;
          return {
            ...game,
            price: detail?.priceOverview?.final ? `$${(detail.priceOverview.final / 100).toFixed(2)}` : null,
            rating: detail?.metacritic?.score || null,
            headerImage: detail?.headerImage || null,
            genres:
              detail?.genres
                ?.map((g) => g.description)
                .slice(0, 2)
                .join(', ') || null,
          };
        } catch {
          return { ...game, price: null, rating: null, headerImage: null };
        }
      }),
    );
    allGames = enriched;
  } catch (e) {
    error = e.message;
  }
}

// 获取全部游戏数量
const totalGames = allGames.length;
// 将数据序列化为 JSON 供客户端使用
const gamesJson = JSON.stringify(allGames);
---

<PageLayout frontmatter={frontmatter}>
    <div class="steam-container">
        <h1>{frontmatter.coverTitle}</h1>
        <p class="subtitle">数据通过 Steam Web API 自动获取，在每次构建时更新。</p>

        {error ? (
            <div class="error-msg">⚠️ 加载失败：{error}</div>
        ) : (
            <>
                <div class="steam-controls">
                    <p class="game-count">共 <strong>{totalGames}</strong> 款游戏</p>
                    <div class="pagination-controls">
                        <span id="page-info">第 1 页</span>
                        <button id="prev-btn" disabled>上一页</button>
                        <button id="next-btn">下一页</button>
                        <select id="page-size-select">
                            <option value="12">每页 12</option>
                            <option value="24" selected>每页 24</option>
                            <option value="48">每页 48</option>
                            <option value="96">每页 96</option>
                        </select>
                    </div>
                </div>

                <div id="game-list-container">
                    <!-- 由 JavaScript 渲染 -->
                </div>
            </>
        )}
    </div>
</PageLayout>

<!-- 注入游戏数据到客户端 -->
<script>
    const gamesData = JSON.parse(`{gamesJson}`);
    let currentPage = 1;
    let pageSize = 24;

    function renderGames() {
        const container = document.getElementById('game-list-container');
        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;
        const pageGames = gamesData.slice(start, end);

        if (pageGames.length === 0 && currentPage > 1) {
            currentPage--;
            renderGames();
            return;
        }

        // 更新分页信息
        const totalPages = Math.ceil(gamesData.length / pageSize);
        document.getElementById('page-info').textContent = `第 ${currentPage} 页 / 共 ${totalPages} 页`;
        document.getElementById('prev-btn').disabled = currentPage <= 1;
        document.getElementById('next-btn').disabled = currentPage >= totalPages;

        // 渲染游戏卡片
        container.innerHTML = `
            <ul class="game-list">
                ${pageGames.map(game => `
                    <li class="game-item">
                        <div class="game-image-wrap">
                            ${game.headerImage
                                ? `<img src="${game.headerImage}" alt="${game.name}" loading="lazy" />`
                                : `<div class="game-image-placeholder">🎮</div>`
                            }
                        </div>
                        <div class="game-info">
                            <span class="game-name">${game.name}</span>
                            ${game.price ? `<span class="game-price">${game.price}</span>` : ''}
                            ${game.rating ? `
                                <span class="game-rating ${game.rating >= 75 ? 'good' : game.rating >= 50 ? 'mid' : 'bad'}">
                                    ⭐ <span class="score">${game.rating}</span> / 100
                                </span>
                            ` : ''}
                            ${game.genres ? `<span class="game-genres">${game.genres}</span>` : ''}
                            <span class="game-playtime">🕐 总游玩 ${Math.round(game.playtime_forever / 60)} 小时</span>
                            ${game.rtime_last_played ? `
                                <span class="game-last-played">最近游玩：${new Date(game.rtime_last_played * 1000).toLocaleDateString('zh-CN')}</span>
                            ` : ''}
                        </div>
                    </li>
                `).join('')}
            </ul>
        `;
    }

    // 绑定事件
    document.getElementById('prev-btn').addEventListener('click', () => {
        if (currentPage > 1) {
            currentPage--;
            renderGames();
        }
    });
    document.getElementById('next-btn').addEventListener('click', () => {
        const totalPages = Math.ceil(gamesData.length / pageSize);
        if (currentPage < totalPages) {
            currentPage++;
            renderGames();
        }
    });
    document.getElementById('page-size-select').addEventListener('change', (e) => {
        pageSize = parseInt(e.target.value);
        currentPage = 1;
        renderGames();
    });

    // 初始渲染
    renderGames();
</script>

<style>
/* ===== 与之前相同的 Steam 深色风格 CSS ===== */
.steam-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 24px;
    background: #1a1e26;
    border-radius: 12px;
    min-height: 60vh;
}

.steam-container h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #e8edf5;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.subtitle {
    color: #8b9bb4;
    font-size: 0.95rem;
    margin-top: 0;
    margin-bottom: 24px;
    border-bottom: 1px solid #2a313c;
    padding-bottom: 16px;
}

/* ===== 控制栏 ===== */
.steam-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
}

.game-count {
    color: #8b9bb4;
    font-size: 0.9rem;
    margin: 0;
}

.pagination-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.pagination-controls span {
    color: #8b9bb4;
    font-size: 0.9rem;
}

.pagination-controls button {
    background: #2a313c;
    color: #e8edf5;
    border: none;
    padding: 6px 16px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: background 0.2s;
}

.pagination-controls button:hover:not(:disabled) {
    background: #3a4555;
}

.pagination-controls button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.pagination-controls select {
    background: #2a313c;
    color: #e8edf5;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.85rem;
    cursor: pointer;
}

/* ===== 游戏网格 ===== */
.game-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    padding: 0;
    list-style: none;
}

.game-item {
    display: flex;
    flex-direction: column;
    background: #262d38;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.3s ease;
    cursor: default;
    position: relative;
}

.game-item:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6), 0 0 30px rgba(102, 192, 244, 0.08);
}

.game-image-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    background: #1a1e26;
    overflow: hidden;
    flex-shrink: 0;
}

.game-image-wrap img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.game-item:hover .game-image-wrap img {
    transform: scale(1.05);
}

.game-image-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    background: #1a1e26;
    color: #4a5568;
}

.game-info {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
}

.game-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: #e8edf5;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.game-price {
    font-size: 0.9rem;
    font-weight: 600;
    color: #67c1f5;
    margin-top: 2px;
}

.game-price.free {
    color: #8b9bb4;
    font-weight: 400;
}

.game-rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    color: #8b9bb4;
    margin-top: 2px;
}

.game-rating .score {
    color: #e8edf5;
    font-weight: 600;
}

.game-rating.good .score { color: #6bce7a; }
.game-rating.mid .score { color: #f5c842; }
.game-rating.bad .score { color: #e86b6b; }

.game-genres {
    font-size: 0.75rem;
    color: #6a7a8f;
    margin-top: 2px;
}

.game-playtime {
    font-size: 0.75rem;
    color: #6a7a8f;
    margin-top: 4px;
}

.game-last-played {
    font-size: 0.7rem;
    color: #4a5a6f;
}

.error-msg {
    color: #e86b6b;
    background: rgba(232, 107, 107, 0.12);
    padding: 12px 16px;
    border-radius: 8px;
    margin: 20px 0;
    border: 1px solid rgba(232, 107, 107, 0.2);
}

@media (max-width: 640px) {
    .steam-container {
        padding: 12px 16px;
    }
    .game-list {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
    }
    .game-info {
        padding: 8px 10px 10px;
    }
    .game-name {
        font-size: 0.85rem;
    }
    .steam-controls {
        flex-direction: column;
        align-items: stretch;
    }
    .pagination-controls {
        justify-content: center;
    }
}
</style>