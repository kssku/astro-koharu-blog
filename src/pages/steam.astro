---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING } from '@constants/layout';
// src/pages/steam.astro
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { defaultLocale } from '@/i18n';
import '@/styles/global/steam.css';

interface Props {
  locale?: string;
}

interface SteamGame {
  appid: number;
  name?: string;
  playtime_forever?: number;
  price?: string | null;
  rating?: number | null;
  headerImage?: string;
  genres?: string[];
  genresDisplay?: string | null;
  releaseDate?: string | null;
  developer?: string | null;
  releaseYear?: string | null;
}

interface SteamApiGame {
  appid: number;
  name?: string;
  playtime_forever?: number;
}

interface SteamAppDetails {
  name?: string;
  header_image?: string;
  genres?: { description: string }[];
  priceOverview?: { final?: number };
  metacritic?: { score?: number };
  releaseDate?: { date?: string };
  developers?: string[];
}

const { locale = defaultLocale } = Astro.props;
const title = `🎮 Steam 游戏库 | ${siteConfig.title}`;
const description = '通过 Steam Web API 自动同步的游戏列表，支持分类筛选与排序';

// -------- Steam API 配置 --------
const STEAM_API_KEY = process.env.STEAM_API_KEY || import.meta.env.STEAM_API_KEY;
const STEAM_ID = '76561199521447257';

let allGames: SteamGame[] = [];
let error: string | null = null;

if (!STEAM_API_KEY) {
  error = '未配置 Steam API Key，请在 Cloudflare Pages 环境变量中设置 STEAM_API_KEY。';
} else {
  try {
    const listUrl = `https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key=${STEAM_API_KEY}&steamid=${STEAM_ID}&include_appinfo=true&include_played_free_games=true&format=json`;
    const listRes = await fetch(listUrl);
    if (!listRes.ok) throw new Error(`HTTP ${listRes.status}`);
    const listJson = (await listRes.json()) as { response?: { games?: SteamApiGame[] } };
    const rawGames: SteamApiGame[] = listJson.response?.games || [];
    rawGames.sort((a, b) => (b.playtime_forever ?? 0) - (a.playtime_forever ?? 0));

    const topGames = rawGames.slice(0, 200);
    const enriched = await Promise.all(
      topGames.map(async (game): Promise<SteamGame> => {
        try {
          const detailUrl = `https://store.steampowered.com/api/appdetails?appids=${game.appid}&l=schinese`;
          const detailRes = await fetch(detailUrl, { headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36' } });
          const detailJson = (await detailRes.json()) as Record<string, { data?: SteamAppDetails }>;
          const detail = detailJson[game.appid]?.data;
          const genres = detail?.genres?.map((g) => g.description) || [];
          return {
            ...game,
            headerImage: detail?.header_image || `https://steamcdn-a.akamaihd.net/steam/apps/${game.appid}/header.jpg`,
            genres: genres,
            genresDisplay: genres.slice(0, 2).join('、') || null,
          };
        } catch (e) {
          return {
            ...game,
            headerImage: `https://steamcdn-a.akamaihd.net/steam/apps/${game.appid}/header.jpg`,
            genres: [],
            genresDisplay: null,
          };
        }
      }),
    );
    allGames = enriched;
  } catch (e) {
    console.error('Steam API 请求失败:', e);
    error = e instanceof Error ? e.message : String(e);
  }
}

// 提取常见类型用于分类标签
const genreCount = new Map<string, number>();
for (const game of allGames) {
  for (const genre of game.genres || []) {
    genreCount.set(genre, (genreCount.get(genre) || 0) + 1);
  }
}
const topGenres = [...genreCount.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([genre]) => genre);

const totalCount = allGames.length;
---

<Layout locale={locale} title={title} description={description}>
  <TwoColumnLayout>
    <Cover slot="cover" title="🎮 Steam 游戏库" />
    <HomeSider slot="sider" />
    <div
      class={`bg-gradient-start shadow-box tablet:shadow-none flex flex-col overflow-hidden ${CONTENT_PADDING.standard}`}
    >
      {error ? (
        <div class="error-msg">⚠️ 加载失败：{error}</div>
      ) : allGames.length === 0 ? (
        <div class="error-msg">⚠️ 没有获取到任何游戏数据，请检查 Steam 个人资料是否公开。</div>
      ) : (
        <>
          <p class="steam-subtitle">数据通过 Steam Web API 自动获取，在每次构建时更新。共 <strong>{totalCount}</strong> 款游戏。</p>

          <!-- 分类标签栏 -->
          <div class="genre-tabs">
            <button class="genre-tab active" data-genre="all">全部 <span class="count">{totalCount}</span></button>
            <button class="genre-tab" data-genre="recent">最近玩过</button>
            {topGenres.map(genre => (
              <button class="genre-tab" data-genre={genre}>{genre}</button>
            ))}
          </div>

          <!-- 排序控制栏 -->
          <div class="steam-controls">
            <div class="controls-left">
              <span id="filtered-count" style="display:none;">显示 <strong>0</strong> 款</span>
            </div>
            <div class="controls-right">
              <select id="sort-select">
                <option value="playtime">总游玩时间 (高→低)</option>
                <option value="recent">最近游玩 (新→旧)</option>
                <option value="name">游戏名称 (A→Z)</option>
              </select>
            </div>
          </div>

          <!-- 游戏列表容器 -->
          <div id="game-list-container">
            <!-- 由 JavaScript 渲染 -->
          </div>
        </>
      )}
    </div>
  </TwoColumnLayout>
</Layout>

<!-- 使用 define:vars 注入数据；含属性即视为 is:inline，此处显式声明 -->
<script is:inline define:vars={{ games: allGames, topGenres }}>
  (function() {
    if (!games || !games.length) {
      document.getElementById('game-list-container').innerHTML = '<p class="empty-msg">没有游戏数据，请检查配置。</p>';
      return;
    }

    let currentSort = 'playtime';
    let currentGenre = 'all';

    const container = document.getElementById('game-list-container');
    const sortSelect = document.getElementById('sort-select');
    const filteredCountEl = document.getElementById('filtered-count');

    // 分类标签点击事件
    document.querySelectorAll('.genre-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.genre-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        currentGenre = this.dataset.genre;
        renderGames();
      });
    });

    function gameMatchesGenre(game, genre) {
      if (genre === 'all') return true;
      if (genre === 'recent') {
        const now = Date.now() / 1000;
        const oneMonthAgo = now - 30 * 24 * 60 * 60;
        return game.rtime_last_played && game.rtime_last_played >= oneMonthAgo;
      }
      return (game.genres || []).some(g => g === genre);
    }

    function renderGames() {
      let filtered = games.filter(game => gameMatchesGenre(game, currentGenre));

      const sorted = [...filtered];
      switch (currentSort) {
        case 'playtime':
          sorted.sort((a, b) => b.playtime_forever - a.playtime_forever);
          break;
        case 'recent':
          sorted.sort((a, b) => (b.rtime_last_played || 0) - (a.rtime_last_played || 0));
          break;
        case 'name':
          sorted.sort((a, b) => a.name.localeCompare(b.name));
          break;
      }

      if (currentGenre === 'all') {
        filteredCountEl.style.display = 'none';
      } else {
        filteredCountEl.style.display = 'inline';
      }

      if (sorted.length === 0) {
        container.innerHTML = `<p class="empty-msg">没有找到符合条件游戏 😢</p>`;
        return;
      }

      let html = `<ul class="game-list">`;
      sorted.forEach((game, index) => {
        const leftClip = index % 2 === 0;
        const imgOnLeft = leftClip;
        html += `
          <li class="game-item ${imgOnLeft ? "img-left" : "img-right"}">
            <a class="game-image-wrap" href="https://steamcommunity.com/app/${game.appid}" target="_blank" rel="noopener" aria-label="在 Steam 查看">
              ${game.headerImage
                ? `<img src="${game.headerImage}" alt="${game.name}" loading="lazy" />`
                : `<div class="game-image-placeholder">🎮</div>`
              }
            </a>
            <div class="game-info">
              ${game.genresDisplay ? `<div class="game-tags"><span class="game-tag">🎮 ${game.genresDisplay}</span></div>` : ""}
              <span class="game-name">${game.name}</span>
              <div class="game-stats">
                <span class="game-playtime">🕐 总游玩 ${Math.round(game.playtime_forever / 60)} 小时</span>
                ${game.rtime_last_played ? `<span class="game-last-played">🕹️ 最近 ${new Date(game.rtime_last_played * 1000).toLocaleDateString("zh-CN")}</span>` : ""}
              </div>
              <a class="game-more" href="https://steamcommunity.com/app/${game.appid}" target="_blank" rel="noopener">more...</a>
            </div>
          </li>
        `;
      });
      html += `</ul>`;
      container.innerHTML = html;
    }

    sortSelect.addEventListener('change', (e) => {
      currentSort = e.target.value;
      renderGames();
    });

    renderGames();
  })();
</script>

